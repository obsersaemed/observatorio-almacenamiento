# Copiar a .env.local (no se sube al repositorio) y completar con el proyecto Supabase "pruebas".
# Públicas (llegan al navegador):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Solo servidor (nunca con prefijo NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# Dirección pública del sitio (metadatos, robots, sitemap). En local puede quedar vacía.
NEXT_PUBLIC_SITIO_URL=
